<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Camera Preview (Edge-to-Edge) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:scaleType="fillCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CaptureKit Feedback Layers (Edge-to-Edge overlay) -->
    <com.capturekit.view.CaptureKitOverlayLayout
        android:id="@+id/captureKitOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Status/Instructions Panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#B3000000"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textAlignment="center"
                android:fontFamily="sans-serif-medium"
                android:text="Ready - Set a reference to start matching" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Controls & Opacity Slider Panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/controlPanelCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#B3121212"
        app:strokeColor="#22FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Opacity Slider Row (Ghost Overlay) -->
            <LinearLayout
                android:id="@+id/sliderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/txtOpacityLabel"
                    android:layout_width="85dp"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Ghost Alpha" />

                <SeekBar
                    android:id="@+id/opacitySlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="35"
                    android:thumbTint="@android:color/white"
                    android:progressTint="@android:color/white" />

                <TextView
                    android:id="@+id/txtOpacityValue"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textAlignment="viewEnd"
                    android:fontFamily="sans-serif"
                    android:text="35%" />
            </LinearLayout>

            <!-- Required Match Slider Row (Custom Threshold) -->
            <LinearLayout
                android:id="@+id/matchSliderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/txtMatchLabel"
                    android:layout_width="85dp"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Min Match" />

                <SeekBar
                    android:id="@+id/matchSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="80"
                    android:thumbTint="@android:color/white"
                    android:progressTint="@android:color/white" />

                <TextView
                    android:id="@+id/txtMatchValue"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textAlignment="viewEnd"
                    android:fontFamily="sans-serif"
                    android:text="80%" />
            </LinearLayout>

            <!-- Ghost View Mode Selector -->
            <LinearLayout
                android:id="@+id/modeSelectorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/txtModeLabel"
                    android:layout_width="85dp"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Ghost Mode" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/ghostModeToggleGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:singleSelection="true"
                    app:checkedButton="@id/btnModeNormal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeNormal"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:textSize="10sp"
                        android:textColor="@android:color/white"
                        android:text="Photo"
                        app:strokeColor="#40FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeEdges"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:textSize="10sp"
                        android:textColor="@android:color/white"
                        android:text="Outline"
                        app:strokeColor="#40FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeTinted"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:textSize="10sp"
                        android:textColor="@android:color/white"
                        android:text="Tinted"
                        app:strokeColor="#40FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeGrayscale"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:textSize="10sp"
                        android:textColor="@android:color/white"
                        android:text="Gray"
                        app:strokeColor="#40FFFFFF" />

                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <!-- Buttons Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Set Reference (Left) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetReference"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:text="Reference"
                    app:icon="@drawable/ic_gallery"
                    app:iconSize="18dp"
                    app:iconTint="@android:color/white"
                    app:strokeColor="#80FFFFFF" />

                <!-- Capture (Center) -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnCapture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:contentDescription="Capture"
                    app:srcCompat="@drawable/ic_camera"
                    app:tint="@android:color/black"
                    app:backgroundTint="@android:color/white"
                    app:fabSize="normal" />

                <!-- Ghost Toggle (Right) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleGhost"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:text="Ghost"
                    app:icon="@drawable/ic_ghost"
                    app:iconSize="18dp"
                    app:iconTint="@android:color/white"
                    app:strokeColor="#80FFFFFF" />

            </RelativeLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
